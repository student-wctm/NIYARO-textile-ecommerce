# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real credentials must never be committed
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.example is safe (placeholders only) and IS committed


# IDE / AI tool working directories — not part of the project
.agents/
.claude/
.windsurf/
.kiro/
skills-lock.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
