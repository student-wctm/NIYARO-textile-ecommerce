# ============================================================================
# NIYARO — Environment Variable Template
# Copy to .env.local and fill in your actual values.
# This file is safe to commit — it contains no secrets.
# ============================================================================

# PostgreSQL connection string (Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ── Vercel Blob ───────────────────────────────────────────────────────────────
# Required for product image uploads.
# Steps to get this token:
#   1. Go to https://vercel.com/dashboard
#   2. Open your project → Storage → Create Blob Store (free tier available)
#   3. Copy the BLOB_READ_WRITE_TOKEN from the store settings
#   4. Paste it below in your .env.local (NOT this file)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXXXXXXXXXXXXXX"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="NIYARO"
